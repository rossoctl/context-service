# Context Service endpoint.
CS_URL=https://context-service.example.com

# Token required by the public Istio gateway.
CS_TOKEN=replace-with-gateway-token

# Authenticated platform identity used for Context Service authorization.
CS_SUBJECT=user:your-name

# Default used by `contextctl create` when -c is omitted.
CS_STORAGE_CLASS=ibm-scale-csi
